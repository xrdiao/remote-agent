{
  "name": "ra-gateway-qa",
  "main": "worker.mjs",
  "compatibility_date": "2025-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "RA_GATEWAY_MODE": "local-test",
    "RA_DEVICE_ID": "qa-a"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_LINK",
        "class_name": "DeviceLink"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceLink"
      ]
    }
  ]
}
